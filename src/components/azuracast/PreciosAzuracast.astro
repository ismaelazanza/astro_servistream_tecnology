---
interface Props {
    title: string;
    core: string;
    ram: string;
    disco: string;
    precio?: string;
    gbit: string;
    link: string;
}

const {
    core,
    title,
    ram,
    disco,
    precio,
    link,
    gbit,

} = Astro.props;
---
    
    <div class="contenedor_planes azura-price mx-auto w-full" data-reveal>
        <a class="block w-full border-4 border-back rounded-lg p-4" href={link}>
            <div>
                <p class="text-2xl font-bold">{title}</p>
                <p class="text-xs">SERVIDOR PROPIO | INSTALACIÓN EN UNAS HORAS</p>
            </div>

            <div class="mt-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-6 sm:gap-4">
                <div class="flex items-center">
                    <p class="font-bold">{core}</p>
                </div>
                <div class="flex items-center">
                    <p class="font-bold">{ram}</p>
                </div>
                <div class="flex items-center">
                    <p class="font-bold">{disco}</p>
                </div>
                <div class="flex items-center">
                    <p class="font-bold">{gbit}</p>
                </div>
                <div class="flex items-center">
                    <p class="font-bold">Tráfico Ilimitado</p>
                </div>
                <div class="flex items-center sm:justify-end">
                    <p class="font-bold"><span class="text-3xl">{precio}</span>/mes</p>
                </div>
            </div>
        </a>
    </div>

 
    <style>
    .back {
        background-color: #efefef;
    }

    .grid_20 {
        display: grid;
        grid-template-columns: 30px repeat(6, minmax(0, 1fr));
    }

    .contenedor_planes{
        max-width: 850px;
    }

    .azura-price { transition: transform .3s ease; }
    .azura-price a { position: relative; overflow: hidden; border-color: rgb(46 94 231 / .15); background: rgb(255 255 255 / .72); box-shadow: 0 8px 24px rgb(47 74 142 / .06); transition: border-color .3s ease, box-shadow .3s ease, background .3s ease; }
    .azura-price a::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(110deg, transparent 38%, rgb(102 132 255 / .12) 50%, transparent 62%); transform: translateX(-115%); transition: transform .65s ease; }
    .azura-price:hover { transform: translateY(-4px); }
    .azura-price:hover a { border-color: rgb(58 99 240 / .52); background: #fff; box-shadow: 0 18px 38px rgb(47 74 142 / .15); }
    .azura-price:hover a::after { transform: translateX(115%); }
    @media (prefers-reduced-motion: reduce) { .azura-price, .azura-price a, .azura-price a::after { transition: none; } }

    .bg_cuadro{
        background-color: #77fb53;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        margin-left: 8px;
        margin-top: 12px;
    }

</style>
