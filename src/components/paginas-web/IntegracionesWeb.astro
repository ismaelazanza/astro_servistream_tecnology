---
const technologies = [
  { name: 'WordPress', mark: 'wordpress', desktop: 'lg:col-start-1 lg:row-start-1' },
  { name: 'HTML5', mark: 'html', desktop: 'lg:col-start-2 lg:row-start-1' },
  { name: 'CSS3', mark: 'css', desktop: 'lg:col-start-1 lg:row-start-2' },
  { name: 'Sass', mark: 'sass', desktop: 'lg:col-start-2 lg:row-start-2' },
  { name: 'Astro', mark: 'astro', desktop: 'lg:col-start-3 lg:row-start-2' },
  { name: 'JavaScript', mark: 'javascript', desktop: 'lg:col-start-4 lg:row-start-2' },
  { name: 'Python', mark: 'python', desktop: 'lg:col-start-1 lg:row-start-3' },
  { name: 'Tailwind CSS', mark: 'tailwind', desktop: 'lg:col-start-2 lg:row-start-3' },
  { name: 'Bootstrap', mark: 'bootstrap', desktop: 'lg:col-start-3 lg:row-start-3' },
