<section class="bg-[#f7f7f6] px-4 py-14 sm:px-6 sm:py-20 lg:px-10 lg:py-28" aria-labelledby="integraciones-title">
  <div class="mx-auto grid max-w-[110rem] grid-cols-2 border-l border-t border-[#dedfe3] lg:grid-cols-4">
    <header class="col-span-2 row-start-1 flex min-h-56 flex-col justify-center border-r border-b border-[#dedfe3] bg-[#eef5ff] px-6 py-10 sm:min-h-64 sm:px-10 lg:col-start-3 lg:min-h-64 lg:px-7 xl:px-12">
      <p class="font-[var(--fuente-principal)] text-xs font-medium tracking-[.08em] text-[#00b285] uppercase sm:text-sm">Integraciones</p>
      <h2 id="integraciones-title" class="mt-3 max-w-3xl text-[clamp(2.35rem,4vw,4.7rem)] leading-[.96] text-[var(--h-negro)]">
        Trabajamos con estas tecnologías
      </h2>
    </header>

    {technologies.map((technology) => (
      <article
        class:list={[
