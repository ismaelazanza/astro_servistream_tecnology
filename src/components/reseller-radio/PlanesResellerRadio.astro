---
import MaterialIcon from "../MaterialIcon.astro";

const plans = [
  {
    name: "Streaming Star",
    price: "$35",
    label: "Plan de inicio",
    href: "https://clientes.servistream.net/index.php?rp=/store/streaming-reseller-radio/streaming-start",
    features: [
      "Radios ilimitadas",
      "Hasta 192 KBPS",
      "100 GB de transferencia",
      "Compatible con SSL",
      "AutoDJ ilimitado",
      "Soporte para móviles",
      "Reproductor HTML5",
      "Shoutcast / Icecast",
      "Panel SonicPanel",
      "App Android (aplican restricciones)",
    ],
  },
  {
    name: "Streaming Smart",
    price: "$42",
    label: "Plan básico",
    href: "https://clientes.servistream.net/index.php?rp=/store/streaming-reseller-radio/streaming-smart",
    popular: true,
    features: [
      "Radios ilimitadas",
      "Hasta 192 KBPS",
      "500 GB de transferencia",
      "Compatible con SSL",
      "AutoDJ ilimitado",
      "Soporte para móviles",
      "Reproductor HTML5",
      "Shoutcast / Icecast",
      "Panel SonicPanel",
      "App Android (aplican restricciones)",
    ],
  },
  {
    name: "Streaming Max",
    price: "$55",
    label: "Plan intermedio",
    href: "https://clientes.servistream.net/index.php?rp=/store/streaming-reseller-radio/streaming-max",
    features: [
      "Radios ilimitadas",
      "Hasta 320 KBPS",
      "1.000 GB de transferencia",
      "Compatible con SSL",
      "AutoDJ ilimitado",
      "Soporte para móviles",
      "Reproductor HTML5",
      "Shoutcast / Icecast",
      "Panel SonicPanel",
      "App Android (aplican restricciones)",
    ],
  },
  {
    name: "Streaming Pro",
    price: "$65",
    label: "Plan avanzado",
    href: "https://clientes.servistream.net/index.php?rp=/store/streaming-reseller-radio/streaming-pro",
    featured: true,
    features: [
      "Radios ilimitadas",
      "Hasta 320 KBPS",
      "Transferencia ilimitada",
      "Compatible con SSL",
      "AutoDJ ilimitado",
      "Soporte para móviles",
      "Reproductor HTML5",
      "Shoutcast / Icecast",
      "Panel SonicPanel",
      "App Android (aplican restricciones)",
    ],
  },
];
---

<section
  id="planes"
  class="relative overflow-hidden bg-[#03040d] py-20 text-white sm:py-28"
  aria-labelledby="reseller-plans-title"
>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[46rem] bg-[radial-gradient(ellipse_at_50%_20%,rgba(108,27,231,.5),transparent_45%),radial-gradient(ellipse_at_25%_18%,rgba(22,54,220,.37),transparent_34%),linear-gradient(180deg,#050516_0%,#03040d_86%)]"
  >
  </div>
  <svg
    class="reseller-signal-lines pointer-events-none absolute left-0 top-[14rem] h-[52rem] w-full opacity-90"
    viewBox="0 0 1800 800"
    preserveAspectRatio="none"
    aria-hidden="true"
    ><defs
      ><linearGradient id="reseller-beam" x1="0" x2="1"
        ><stop stop-color="#263fff" stop-opacity="0"></stop><stop
          offset=".12"
          stop-color="#4d6bff"
          stop-opacity=".65"></stop><stop
          offset=".55"
          stop-color="#435dff"
          stop-opacity=".9"></stop><stop
          offset="1"
          stop-color="#a06cff"
          stop-opacity=".12"></stop></linearGradient
      ><filter id="reseller-glow"
        ><feGaussianBlur stdDeviation="3"></feGaussianBlur></filter
      ></defs
    ><g fill="none" stroke="url(#reseller-beam)" stroke-linecap="round"
      ><path
        class="reseller-signal-glow"
        d="M-120 230 C190 280 325 425 640 435 S1200 380 1920 610"
        stroke-width="1.5"
        filter="url(#reseller-glow)"></path><path
        class="reseller-signal-path"
        d="M-120 230 C190 280 325 425 640 435 S1200 380 1920 610"
        stroke-width="1.2"></path><path
        class="reseller-signal-path reseller-signal-path--slow"
        d="M-80 260 C220 310 380 455 700 470 S1260 420 1900 650"
        stroke-width="1.2"></path><path
        class="reseller-signal-path reseller-signal-path--reverse"
        d="M-90 294 C210 340 410 495 750 505 S1290 465 1920 682"
        stroke-width="1"></path></g
    ></svg
  >
  <div class="relative mx-auto container px-5 sm:px-8">
    <header class="mx-auto max-w-5xl text-center">
      <h5 class="mt-10 text-[#a99cff]">RESELLER RADIO STREAMING</h5><h1
        id="reseller-plans-title"
        class="mt-6 text-[60px] leading-[.92] text-[var(--h-blanco)]"
      >
        Convierte tu experiencia en <br class="hidden sm:block" />un negocio de
        radio online
      </h1><p
        class="mx-auto mt-7 max-w-3xl font-[var(--fuente-principal)] leading-relaxed text-[#c4c5d5]"
      >
        Crea y administra radios para tus clientes bajo tu propia marca.
        Nosotros cuidamos la infraestructura; tú haces crecer tu negocio.
      </p><a
        href="https://clientes.servistream.net/index.php?rp=/store/streaming-reseller-radio/streaming-smart"
        class="mt-9 inline-flex min-h-11 items-center justify-center rounded-full border border-white/20 bg-white/10 px-6 font-[var(--fuente-principal)] font-semibold text-white no-underline transition hover:-translate-y-0.5 hover:bg-white/15"
        >Comenzar como reseller <MaterialIcon
          name="arrow_forward"
          size={19}
          class="ml-2"
        /></a>
    </header><div
      class="relative mt-24 grid gap-6 md:grid-cols-2 xl:grid-cols-4 xl:items-stretch"
    >
      {
        plans.map((plan) => (
          <article
            class:list={[
              "reseller-plan-card relative flex min-h-full flex-col rounded-3xl border border-white/7 p-6 font-[var(--fuente-principal)] backdrop-blur-[3px]",
              plan.featured
                ? "bg-[linear-gradient(145deg,rgba(60,54,112,.42),rgba(18,16,41,.22))]"
                : "",
            ]}
          >
            {plan.popular && (
              <span class="absolute -top-4 left-1/2 z-20 -translate-x-1/2 rounded-full bg-[#6c57ff] px-4 py-1 text-xs font-bold text-white">
                MÁS ELEGIDO
              </span>
            )}
            {plan.featured && (
              <span class="inline-flex self-start rounded-lg bg-white/10 px-3 py-1.5 text-sm text-white">
                Para tu negocio
              </span>
            )}
            <p class="mt-1 text-sm text-[#deddea]">{plan.name}</p>
            <>
              <p class="mt-7 text-[clamp(3rem,2vw,5rem)] leading-none text-white">
                {plan.price}
                <span class="ml-2 text-base tracking-normal text-[#b4b3c4]">
                  /mes
                </span>
              </p>
              <p class="mt-3 text-sm font-semibold text-[#a99cff]">
                {plan.label}
              </p>
              <a
                href={plan.href}
                class:list={[
                  "mt-10 flex min-h-10 items-center justify-center rounded-full border font-semibold text-white no-underline transition hover:-translate-y-0.5",
                  plan.featured
                    ? "border-[#6c57ff] bg-[#5c48f7] hover:bg-[#4c38ec]"
                    : "border-white/20 bg-white/10 hover:bg-white/15",
                ]}
              >
                Elegir este plan
              </a>
              <div class="my-10 border-t border-white/10" />
              <p class="text-xs font-semibold text-white">
                Características incluidas:
              </p>
              <ul
                class="mt-6 grid gap-1 text-sm font-light text-[#c1c0d0]"
                role="list"
              >
                {plan.features.map((feature) => (
                  <li class="flex gap-3">
                    <MaterialIcon
                      name="check"
                      size={19}
                      class="shrink-0 text-[#8f82ff]"
                    />
                    {feature}
                  </li>
                ))}
              </ul>
            </>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .reseller-signal-path {
    stroke-dasharray: 24 38;
    animation: reseller-signal-flow 12s linear infinite;
  }
  .reseller-signal-glow {
    stroke-dasharray: 16 52;
    animation: reseller-signal-flow 10s linear infinite;
  }
  .reseller-signal-path--slow {
    animation-duration: 18s;
  }
  .reseller-signal-path--reverse {
    animation-duration: 15s;
    animation-direction: reverse;
  }
  .reseller-plan-card {
    overflow: visible;
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }
  .reseller-plan-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      20rem circle at var(--surface-x, 50%) var(--surface-y, 0%),
      rgb(150 124 255 / 0.22),
      transparent 58%
    );
    transition: opacity 0.35s ease;
  }
  .reseller-plan-card:hover {
    transform: translateY(-8px);
    border-color: rgb(168 143 255 / 0.48);
    box-shadow: 0 26px 54px rgb(20 11 69 / 0.38);
  }
  .reseller-plan-card:hover::before {
    opacity: 1;
  }
  @keyframes reseller-signal-flow {
    to {
      stroke-dashoffset: -248;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .reseller-signal-path,
    .reseller-signal-glow {
      animation: none;
    }
    .reseller-plan-card {
      transition: none;
    }
  }
</style>
