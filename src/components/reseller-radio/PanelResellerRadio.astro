---
import MaterialIcon from "../MaterialIcon.astro";
---

<section
    class="bg-[#03040d] py-20 text-white sm:py-32"
    aria-labelledby="reseller-panel-title"
>
    <div class="mx-auto container px-5 sm:px-8">
        <div
            class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-[linear-gradient(135deg,rgba(62,53,137,.38),rgba(10,9,29,.86))] p-6 shadow-[inset_0_1px_0_rgb(255_255_255_/_12%)] sm:p-12"
        >
            <div
                class="pointer-events-none absolute -right-28 -top-28 size-96 rounded-full bg-[#694bff]/25 blur-3xl"
            >
            </div><div
                class="relative grid items-center gap-12 lg:grid-cols-[.85fr_1.15fr]"
            >
                <div>
                    <h5 class="text-[#a99cff] text-left">
                        SONICPANEL PARA REVENDEDORES
                    </h5><h2
                        id="reseller-panel-title"
                        class="mt-5 text-[var(--h-blanco)]"
                    >
                        Gestiona cada radio desde un solo lugar
                    </h2><p
                        class="mt-6 font-[var(--fuente-principal)] text-lg leading-relaxed text-[#bdbbd1]"
                    >
                        Crea cuentas, revisa la actividad y administra las
                        radios de tus clientes con un entorno centralizado y
                        fácil de usar.
                    </p><a
                        href="#planes"
                        class="mt-8 inline-flex items-center gap-2 font-[var(--fuente-principal)] font-semibold text-[#a99cff] no-underline"
                        >Ver planes reseller <MaterialIcon
                            name="arrow_forward"
                            size={19}
                        /></a>
                </div><div
                    class="rounded-2xl border border-white/10 bg-[#0d0c20]/80 p-5 shadow-2xl sm:p-7"
                >
                    <div
                        class="flex items-center justify-between border-b border-white/10 pb-5"
                    >
                        <div class="flex items-center gap-3">
                            <span
                                class="grid size-10 place-items-center rounded-xl bg-[#6654ee]"
                                ><MaterialIcon
                                    name="graphic_eq"
                                    size={22}
                                /></span
                            ><div>
                                <p
                                    class="font-[var(--fuente-principal)] font-bold"
                                >
                                    Panel de revendedor
                                </p><p class="text-xs text-[#aaa6c8]">
                                    Todas tus radios en un vistazo
                                </p>
                            </div>
                        </div><span
                            class="rounded-full bg-[#69d49a]/15 px-3 py-1 text-xs font-semibold text-[#8ff0b6]"
                            >EN LÍNEA</span>
                    </div><div class="mt-6 grid gap-3 sm:grid-cols-3">
                        {
                            [
                                {
                                    label: "Cuentas activas",
                                    value: "24",
                                    icon: "radio",
                                },
                                {
                                    label: "Radios en vivo",
                                    value: "18",
                                    icon: "podcasts",
                                },
                                {
                                    label: "Uso mensual",
                                    value: "68%",
                                    icon: "monitoring",
                                },
                            ].map((stat) => (
                                <div class="rounded-xl border border-white/8 bg-white/5 p-4">
                                    <>
                                        <MaterialIcon
                                            name={stat.icon}
                                            size={20}
                                            class="text-[#a99cff]"
                                        />
                                        <p class="mt-5 text-2xl font-bold text-white">
                                            {stat.value}
                                        </p>
                                        <p class="mt-1 text-xs text-[#a7a4c1]">
                                            {stat.label}
                                        </p>
                                    </>
                                </div>
                            ))
                        }
                    </div><div class="mt-5 space-y-3">
                        {
                            [
                                "Radio Horizonte — En vivo",
                                "Voces del Valle — AutoDJ activo",
                                "Stereo Centro — En vivo",
                            ].map((station, index) => (
                                <div class="flex items-center gap-3 rounded-xl border border-white/8 bg-white/5 px-4 py-3">
                                    <>
                                        <span
                                            class:list={[
                                                "size-2 rounded-full",
                                                index === 1
                                                    ? "bg-[#a99cff]"
                                                    : "bg-[#74e1a2]",
                                            ]}
                                        />
                                        <span class="font-[var(--fuente-principal)] text-sm">
                                            {station}
                                        </span>
                                        <MaterialIcon
                                            name="more_horiz"
                                            size={19}
                                            class="ml-auto text-[#9b98b5]"
                                        />
                                    </>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
