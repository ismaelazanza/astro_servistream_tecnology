---
import MaterialIcon from '../MaterialIcon.astro';
---

<section class="relative overflow-hidden bg-[#030713] px-5 py-20 text-white sm:px-8 sm:py-32" aria-labelledby="contact-title">
  <div data-tv-reveal class="relative mx-auto grid min-h-96 w-full max-w-7xl place-items-center overflow-hidden rounded-[2rem] border border-[#7f9cff]/45 bg-[linear-gradient(120deg,#3e54eb_0%,#526cff_48%,#3648cf_100%)] px-6 py-16 text-center shadow-[0_20px_70px_rgb(19_32_133_/_45%),inset_0_1px_0_rgb(255_255_255_/_25%)] sm:px-12">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_18%_10%,rgba(255,255,255,.19),transparent_27%),radial-gradient(circle_at_82%_100%,rgba(48,23,161,.38),transparent_45%)]"></div>
    <svg class="pointer-events-none absolute -bottom-12 -left-8 h-68 w-[calc(100%+4rem)] opacity-75" viewBox="0 0 1500 350" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M-80 285C270 370 440 255 700 175C995 85 1240 125 1590 10" stroke="white" stroke-opacity=".42" stroke-width="2"/><path d="M-70 305C265 390 480 268 725 198C1035 110 1305 145 1590 36" stroke="white" stroke-opacity=".3" stroke-width="1.5"/><path d="M-10 246C240 340 490 229 685 160C1020 42 1250 105 1550 0" stroke="white" stroke-opacity=".28" stroke-width="1.5"/></svg>
    <div class="pointer-events-none absolute inset-0 opacity-70 [background-image:radial-gradient(circle_at_10%_25%,white_0_1px,transparent_2px),radial-gradient(circle_at_33%_70%,white_0_1px,transparent_2px),radial-gradient(circle_at_57%_20%,white_0_1px,transparent_2px),radial-gradient(circle_at_80%_33%,white_0_1px,transparent_2px),radial-gradient(circle_at_92%_75%,white_0_1px,transparent_2px)]"></div>
    <div class="relative max-w-3xl"><h5 class=" text-[#d8e1ff] ">¿Listo para comenzar?</h5><h2 id="contact-title" class="mt-3 text-[clamp(2.7rem,4vw,5.8rem)] leading-[.94] text-white">Tu canal merece llegar <br>  más lejos.</h2><p class="mx-auto mt-6 max-w-2xl font-[var(--fuente-principal)] leading-relaxed text-[#e1e6ff]">Cuéntanos tu proyecto y recibe orientación para crear, emitir y administrar tu canal de TV online con StreamCP Pro.</p><a href="/contacto" class="mt-9 inline-flex items-center gap-3 rounded-xl border border-white/25 bg-white/14 px-6 py-3.5 font-[var(--fuente-principal)] font-bold text-white no-underline shadow-[inset_0_1px_0_rgb(255_255_255_/_25%)] transition hover:bg-white/23">Hablar con un asesor <MaterialIcon name="arrow_forward" size={20} /></a></div>
  </div>
</section>
